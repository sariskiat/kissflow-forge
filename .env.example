# Kissflow Forge settings — copy to .env and fill. NEVER commit .env.
# app.infrastructure.config.settings.load_settings() is the only reader of these keys.
#
# Every comment lives on its own line, above its key, never on the same line as a value.
# python-dotenv keeps a same-line comment as the literal VALUE when the key itself is left
# empty, so an inline comment on a blank key used to turn that key truthy for anyone who
# copied this file unedited.

# required; must be a bare hostname and must contain "dev-" (HR1)
KF_DEV_DOMAIN=dev-tenant.example.com
# required
KF_DEV_ACCOUNT_ID=
# optional; the single-app default
KF_APP=
# optional; the process-template flow id
KF_PROCESS_TEMPLATE=
# optional; the HTTP port (MCP_HTTP mode only)
PORT=8080
# optional; non-empty runs streamable-http, empty/unset runs stdio
MCP_HTTP=
# optional, stdio only; HTTP reads the caller's own pair from request headers instead
KF_DEV_ACCESS_KEY_ID=
# optional, stdio only; never logged, never stored
KF_DEV_ACCESS_KEY_SECRET=
# optional; code default is 10 (the clone's); set to 30 here to match the old urllib
# transport's TIMEOUT_S so the deployed timeout does not change (spec G5)
HTTP_TIMEOUT_SECONDS=30
