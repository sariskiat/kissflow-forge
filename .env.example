# Kissflow credentials — copy to .env and fill. NEVER commit .env.
# Dev (builder API allowed — domain must contain "dev-")
KF_DEV_ACCESS_KEY_ID=
KF_DEV_ACCESS_KEY_SECRET=
KF_DEV_DOMAIN=dev-kissflow.example.co.th
KF_DEV_ACCOUNT_ID=

# Prod (documented data-plane API, READ-ONLY use; never the builder API)
KF_PROD_ACCESS_KEY_ID=
KF_PROD_ACCESS_KEY_SECRET=
KF_PROD_DOMAIN=
KF_PROD_ACCOUNT_ID=
