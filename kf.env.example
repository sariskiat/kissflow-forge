# Copy to kf.env, fill in the 5 live-tenant secrets, keep it OUT of git.
# The MCP boots without these, but any LIVE build/write tool needs them.
# KF_APP is optional now — omit it and pass app_id per tool call (or use forge_use_app).
KF_DEV_DOMAIN=
KF_DEV_ACCESS_KEY_ID=
KF_DEV_ACCESS_KEY_SECRET=
KF_DEV_ACCOUNT_ID=
KF_APP=

# --- HTTP mode only: per-user Kissflow auth (kfforge/auth.py) -------------------------
# Set BOTH to make the hosted endpoint authenticate every caller with their OWN Kissflow
# access key, pasted into Claude Desktop's connector fields. Leave MCP_OAUTH_BASE_URL
# unset and the endpoint stays unauthenticated (server warns loudly at startup).
# The signing key must be identical on every replica — a per-process one breaks refresh.
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
MCP_OAUTH_BASE_URL=
MCP_OAUTH_SIGNING_KEY=
# Optional: extra allowed OAuth redirect prefixes, comma-separated. Loopback and
# https://*.claude.ai are always allowed.
MCP_OAUTH_ALLOWED_REDIRECTS=
