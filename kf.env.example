# Copy to kf.env, fill in the 5 live-tenant secrets, keep it OUT of git.
# The MCP boots without these, but any LIVE build/write tool needs them.
# KF_APP is optional now — omit it and pass app_id per tool call (or use forge_use_app).
KF_DEV_DOMAIN=
KF_DEV_ACCESS_KEY_ID=
KF_DEV_ACCESS_KEY_SECRET=
KF_DEV_ACCOUNT_ID=
KF_APP=

# --- Non-dev tenant (explicit opt-in, no dev- guard). Used ONLY when KF_DEV_DOMAIN is unset.
KF_DOMAIN=
KF_ACCOUNT_ID=
KF_ACCESS_KEY_ID=
KF_ACCESS_KEY_SECRET=

# --- HTTP mode only: Entra + per-user Kissflow two-gate auth ---------------------------
# Every variable below is required in HTTP mode; incomplete configuration aborts startup.
# Users enter their own Kissflow key ID in OAuth Client ID and secret in OAuth Client Secret.
MCP_OAUTH_BASE_URL=
MCP_OAUTH_SIGNING_KEY=
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REQUIRED_SCOPES=
# Optional Entra scope/redirect settings.
AZURE_ADDITIONAL_SCOPES=
AZURE_REDIRECT_PATH=/auth/callback
AZURE_BASE_AUTHORITY=login.microsoftonline.com
AZURE_IDENTIFIER_URI=
AZURE_TOKEN_ISSUER=
# Optional exact email domains checked against validated Entra claims; comma/space separated.
ALLOWED_EMAIL_DOMAINS=
# Optional extra HTTPS callback patterns. Loopback HTTP and Claude patterns are always allowed.
MCP_OAUTH_ALLOWED_REDIRECTS=
