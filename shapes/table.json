      "Kind": "Column",
      "Type": "Model",
      "Start": 0,
      "End": 6,
      "Name": "Sample Table",
      "AllowImport": false,
      "Row": "Row_Sample01",
      "Column::Model": [
        "Model_Sample02"
      ],
      "MaxRow": 2
    },
    "Model_Sample02": {
      "Id": "Model_Sample02",
      "Kind": "Model",
      "Model": "Model_Sample01",
