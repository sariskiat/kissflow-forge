{
  "kind": "Model",
  "description": "A child table is a nested Model hosted by a Column{Type:Model}, not a field type. The host Column carries MaxRow (Kissflow's native row cap) and must sit in its own ROOT row — a table host cannot live inside a Section (proven: renders an empty section).",
  "source_capture": "table_node_shape.json",
  "template": {
    "Model_Sample01": {
      "Id": "Model_Sample01",
      "Kind": "Model",
      "Model::Model": [
        "Model_Sample02"
      ],
      "Model::Row": [
        "Row_Sample01"
      ]
    },
    "Row_Sample01": {
      "Id": "Row_Sample01",
      "Kind": "Row",
      "Model": "Model_Sample01",
      "Row::Column": [
        "Column_Sample01"
      ]
    },
    "Column_Sample01": {
