  "problem_goal": {
    "done_definition": "the unit is repaired or declared unrepairable, and the customer has been notified",
    "goal": "every repair job is trackable from intake to return, with a clear owner at each step",
    "pain": "technicians and customers cannot see which repair job is stuck or with whom",
    "result_values": [
      "Repaired",
      "Beyond repair",
      "Cancelled by customer"
    ],
    "terminal_states": [
      "Completed",
      "Cancelled"
    ]
  },
  "rework_loops": {
    "confirmed_none": false,
    "loops": [
      {
        "from_stage": "Quality Check",
        "gate_field": "Quality Passed",
        "max_rounds": 3,
        "to_stage": "Repair"
      }
    ]
  },
  "roles": {
    "roles": [
      {
        "is_admin": false,
        "members_hint": "2 front-desk staff",
        "name": "Front Desk"
      },
      {
        "is_admin": false,
        "members_hint": "5 technicians",
        "name": "Technician"
      },
      {
        "is_admin": true,
        "members_hint": "1 manager",
        "name": "Service Manager"
      }
    ]
  },
  "routing": {
    "confirmed_none": false,
    "points": [
      {
        "at_stage": "Diagnose",
        "field_name": "Repairable",
        "options": [
          "Yes",
          "No"
        ],
        "route_per_option": [
          [
            "Yes",
            [
              "Repair"
            ]
          ],
          [
            "No",
            [
              "Return to Customer"
            ]
          ]
        ]
      }
    ]
  },
  "stages": {
    "stages": [
      {
        "entry_criteria": "customer drops off a unit",
        "exit_criteria": "unit logged with a case number",
        "name": "Intake",
        "owner_role": "Front Desk",
        "what_happens": "log the unit and customer details"
      },
      {
        "entry_criteria": "unit logged",
        "exit_criteria": "repairable decision recorded",
        "name": "Diagnose",
        "owner_role": "Technician",
        "what_happens": "assess whether the unit is repairable"
      },
      {
        "entry_criteria": "marked repairable",
        "exit_criteria": "repair work finished",
        "name": "Repair",
        "owner_role": "Technician",
        "what_happens": "perform the repair"
      },
      {
        "entry_criteria": "repair marked finished",
        "exit_criteria": "quality check passed",
        "name": "Quality Check",
        "owner_role": "Service Manager",
        "what_happens": "verify the repair meets standard"
      },
      {
        "entry_criteria": "quality check passed, or unit deemed unrepairable",
        "exit_criteria": "customer notified and job closed",
        "name": "Return to Customer",
        "owner_role": "Front Desk",
        "what_happens": "notify customer and close the job"
      }
    ]
  },
  "test_cases": {
    "cases": [
      {
        "expected_path": [
          "Intake",
          "Diagnose",
          "Repair",
          "Quality Check",
          "Return to Customer"
        ],
        "expected_result": "Repaired",
        "fills": [
          {
            "stage": "Intake",
            "values": [
              [
                "Unit Name",
                "Printer"
              ],
              [
                "Urgency",
                "Medium"
              ]
            ]
          },
          {
            "stage": "Diagnose",
            "values": [
              [
                "Repairable",
                "Yes"
              ]
            ]
          },
          {
            "stage": "Quality Check",
            "values": [
              [
                "Quality Passed",
                "true"
              ]
            ]
          }
        ],
        "name": "Straightforward repair"
      },
      {
        "expected_path": [
          "Intake",
          "Diagnose",
          "Return to Customer"
        ],
        "expected_result": "Beyond repair",
        "fills": [
          {
            "stage": "Intake",
            "values": [
              [
                "Unit Name",
                "Old Fax Machine"
              ],
              [
                "Urgency",
                "Low"
              ]
            ]
          },
          {
            "stage": "Diagnose",
            "values": [
              [
                "Repairable",
                "No"
              ]
            ]
          }
        ],
        "name": "Beyond repair"
      },
      {
        "expected_path": [
          "Intake",
          "Diagnose",
          "Repair",
          "Quality Check",
          "Repair",
          "Quality Check",
          "Return to Customer"
        ],
        "expected_result": "Repaired",
        "fills": [
          {
            "stage": "Intake",
            "values": [
              [
                "Unit Name",
                "Blender"
              ],
              [
                "Urgency",
                "High"
              ]
            ]
          },
          {
            "stage": "Diagnose",
            "values": [
              [
                "Repairable",
                "Yes"
              ]
            ]
          },
          {
            "stage": "Quality Check",
            "values": [
              [
                "Quality Passed",
                "false"
              ]
            ]
          },
          {
            "stage": "Quality Check",
            "values": [
              [
                "Quality Passed",
                "true"
              ]
            ]
          }
        ],
        "name": "Rework then pass"
      }
    ]
  },
